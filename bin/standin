#!/usr/bin/env python3
"""
standin: a tiny fake service for Site Watch to monitor.

Answers every GET with "200 OK". Configured only through environment variables:

  STANDIN_NAME      name shown in replies and logs        (default: standin)
  STANDIN_PORT      port to listen on                     (required)
  STANDIN_DELAY_MS  wait this long before answering       (default: 0)
                    use it to make a component slow, e.g. 1500
  STANDIN_BIND      address to listen on                  (default: 127.0.0.1)

Environment variables are read once at startup: restart the service to apply a change.
Stops cleanly on SIGTERM (what systemctl stop sends).
"""

import os
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

NAME = os.environ.get("STANDIN_NAME", "standin")
BIND = os.environ.get("STANDIN_BIND", "127.0.0.1")

try:
    PORT = int(os.environ["STANDIN_PORT"])
    DELAY_MS = int(os.environ.get("STANDIN_DELAY_MS", "0"))
except KeyError:
    sys.exit("standin: STANDIN_PORT is not set")
except ValueError:
    sys.exit("standin: STANDIN_PORT and STANDIN_DELAY_MS must be whole numbers")


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if DELAY_MS > 0:
            time.sleep(DELAY_MS / 1000)
        body = f"OK {NAME}\n".encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_HEAD(self):
        if DELAY_MS > 0:
            time.sleep(DELAY_MS / 1000)
        self.send_response(200)
        self.end_headers()

    def log_message(self, fmt, *args):
        # one short line per request, to stdout (systemd sends it to the journal)
        print(f"{NAME}: {self.address_string()} {fmt % args}", flush=True)


server = ThreadingHTTPServer((BIND, PORT), Handler)


def stop(signum, _frame):
    print(f"{NAME}: got {signal.Signals(signum).name}, shutting down", flush=True)
    # shutdown() must run outside the thread that is serving
    threading.Thread(target=server.shutdown).start()


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

print(f"{NAME}: listening on {BIND}:{PORT}, delay {DELAY_MS} ms", flush=True)
server.serve_forever()
server.server_close()
print(f"{NAME}: stopped", flush=True)
